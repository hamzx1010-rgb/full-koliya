const https = require('https');

// This function will ping your website every 14 minutes
// to prevent Render from putting the server to sleep.
function keepAlive() {
    // We use the environment variable Render provides automatically
    const appUrl = process.env.RENDER_EXTERNAL_HOSTNAME;

    if (!appUrl) {
        console.log("⚠️ Keep-Alive: No RENDER_EXTERNAL_HOSTNAME found. Skipping ping.");
        return;
    }

    const fullUrl = `https://${appUrl}`;

    setInterval(() => {
        https.get(fullUrl, (res) => {
            console.log(`📡 Self-Ping Sent to ${fullUrl} | Status: ${res.statusCode}`);
        }).on('error', (err) => {
            console.error(`❌ Keep-Alive Error: ${err.message}`);
        });
    }, 840000); // 840,000ms = 14 minutes
}

module.exports = keepAlive;
